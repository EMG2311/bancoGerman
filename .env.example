# Copiar como .env y completar. El .env no se sube a git.

# --- Base de datos (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/deudas?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- Auth (JWT) ---
# Mínimo 32 caracteres. Generar uno con: openssl rand -base64 48
JWT_SECRET=
# Duración del token (7d, 12h, 30m...)
JWT_EXPIRACION=7d

# --- Servidor ---
PORT=8080

# --- Notificaciones push ---
# expo = envío real vía Expo (FCM/APNs) | log = solo loguea
PUSH_PROVEEDOR=expo
# Solo si activás "enhanced push security" en el panel de EAS
EXPO_ACCESS_TOKEN=
